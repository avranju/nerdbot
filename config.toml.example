# ── NerdBot Configuration ─────────────────────────────────────────
# Copy this file to config.toml and adjust for your environment.
# Secrets (API keys) are read from environment variables, not from
# this file.  Set TELEGRAM_BOT_TOKEN and any provider keys before
# starting the bot.

# ── Agent ─────────────────────────────────────────────────────────
[agent]
name = "nerdbot"
personality_file = "/config/personality.md"
max_tool_iterations = 10
default_timezone = "UTC"

# ── Webhook Server ─────────────────────────────────────────────────
# Shared local plain-HTTP listener used when any channel uses webhook ingress.
# TLS, DNS, and reverse proxy/tunnel termination are expected outside NerdBot.
[webhook]
host = "127.0.0.1"
port = 24682

# ── Channels / Telegram ───────────────────────────────────────────
[channels.telegram]
enabled = true
ingress = "poll" # "poll" for getUpdates long polling, "webhook" for Telegram webhooks
bot_token_env = "TELEGRAM_BOT_TOKEN"
poll_interval_secs = 5 # Sleep after an empty getUpdates response in poll mode
# Required when ingress = "webhook"; register this public URL with Telegram.
# NerdBot's webhook listener is plain HTTP; TLS, DNS, and reverse proxy/tunnel
# termination are expected outside NerdBot.
# web_hook_url = "https://example.com/telegram/hook"
# Allowed channel-specific conversation IDs. Telegram conversation/chat IDs are strings here.
# Leave empty to allow all conversations (development mode).
allowed_conversations = []
# Allowed channel-specific sender IDs. Telegram user IDs are strings here.
# Leave empty to allow all senders (development mode).
allowed_senders = []
# Maximum download size for Telegram attachments (images, PDFs, etc.) in bytes.
# Files larger than this limit are rejected before download.
max_attachment_bytes = 5242880
# Maximum number of characters when extracting text from text documents.
# Text documents exceeding this limit are truncated with a notice.
max_text_document_chars = 32768

# ── Channels / Zulip ──────────────────────────────────────────────
# Uncomment and fill in to enable Zulip integration.
# Zulip uses Basic authentication (bot email + API key) instead of a single token.
# [channels.zulip]
# enabled = false
# ingress = "poll" # "poll" for event queue long polling, "webhook" for Zulip outgoing webhooks
# Environment variable containing the bot's email address (e.g. name-bot@org.zulipchat.com).
# bot_email_env = "ZULIP_BOT_EMAIL"
# Environment variable containing the bot's 32-character hex API key.
# api_key_env = "ZULIP_BOT_API_KEY"
# Base URL of the Zulip server (required when enabled).
# site_url = "https://your-org.zulipchat.com"
# Required when ingress = "webhook" — the verification token configured in Zulip's outgoing webhook settings.
# web_hook_token_env = "ZULIP_WEBHOOK_TOKEN"
# Required when ingress = "webhook" — register this public URL with Zulip's outgoing webhook settings.
# NerdBot's webhook listener is plain HTTP; TLS, DNS, and reverse proxy/tunnel
# termination are expected outside NerdBot.
# web_hook_url = "https://example.com/zulip/hook"
# Sleep duration after an empty events response in poll mode (seconds).
# poll_interval_secs = 2
# Experimental: attempt active presence heartbeats. Current Zulip servers reject
# presence updates from bot accounts, so this defaults to false.
# presence_enabled = false
# Active presence heartbeat interval in seconds when enabled.
# presence_ping_interval_secs = 60
# Allowed Zulip conversations using ConversationAddressPattern syntax.
# conversation_id matches stream name; thread_id matches topic name.
# thread_id = None (omitted) matches all topics in a stream.
# Leave empty to allow all streams and senders (development mode).
# allowed_conversations = [
#     { channel_id = "zulip", conversation_id = "general" },
#     { channel_id = "zulip", conversation_id = "engineering", thread_id = "alerts" },
# ]
# Allowed Zulip sender email addresses.
# Leave empty to allow all senders (development mode).
# allowed_senders = []
# Maximum download size for Zulip attachments in bytes.
# max_attachment_bytes = 5242880
# Maximum number of characters when extracting text from text documents.
# max_text_document_chars = 32768

# ── Storage ───────────────────────────────────────────────────────
[storage]
sqlite_path = "/data/agent.db"

# ── Workspace (file tool sandbox root) ────────────────────────────
[workspace]
root = "/workspace"
max_read_bytes = 262144
max_write_bytes = 262144

# ── File I/O Tool ─────────────────────────────────────────────────
# Separate from [workspace] — controls the file tool's own limits.
[files]
max_read_bytes = 262144
max_write_bytes = 262144

# ── LLM ───────────────────────────────────────────────────────────
[llm]
# Model name — genai resolves the provider from the prefix.
# Examples: "gpt-4o" (OpenAI), "claude-sonnet-4-5" (Anthropic),
#           "gemini-2.5-flash" (Gemini), "open_router::anthropic/claude-sonnet-4-5" (OpenRouter).
model = "gpt-4o"
# Optional: custom endpoint (for OpenAI-compatible APIs).
# endpoint = "http://localhost:8080/v1"
# Optional: environment variable name for the API key.
# api_key_env = "MY_CUSTOM_API_KEY"
temperature = 0.2
max_output_tokens = 4096
# Context window size in tokens (model-specific).
# context_window_tokens = 128000
# Retry transient LLM network/server failures. Defaults allow about 40 seconds
# for a local LLM server to come back after the first failed call.
# max_retries = 4
# retry_interval_secs = 10

# ── Context Management ────────────────────────────────────────────
[context]
soft_compaction_threshold = 0.60
hard_context_threshold = 0.85
recent_turns_to_preserve = 30
# Tokens reserved for tool-loop headroom (iterative tool calls).
# reserved_tool_loop_tokens = 8192

# ── Scheduler ─────────────────────────────────────────────────────
[scheduler]
run_overdue_one_shots_on_startup = false

# ── Shell Execution ───────────────────────────────────────────────
[shell]
# Allowed commands (empty = allow all). Commands not listed are blocked.
allowed_commands = []
# Always-denied commands.
denied_commands = ["rm", "chmod", "chown", "mkfs", "dd", "wget", "curl"]
max_output_bytes = 1048576
timeout_secs = 30
# Sandbox isolation mode: "none", "bwrap", or "bwrap-strict".
#
# - "none" (default): Direct execution. No namespace isolation; commands run as
#   the nerdbot user with full host access. The allowlist/denylist checks only
#   inspect the first command word and are not a security boundary against shell
#   features, scripts, or interpreter subcommands.
#
# - "bwrap": Bubblewrap namespace isolation. Commands run inside a
#   sandbox with:
#   • Read-only system files (/usr, /etc, /lib, /bin, /sbin)
#   • Read-write workspace access
#   • PID namespace (can't see host processes)
#   • Network access controlled by network_access below
#   • Clean environment (no host secrets leaked)
#   • IPC and UTS namespace isolation
#
# - "bwrap-strict": Reserved for future resource limit enforcement
#   (--rlimit-nproc, --rlimit-as, --rlimit-core). Currently identical
#   to "bwrap".
#
# Requires bubblewrap to be installed:
#   apt install bubblewrap (Debian/Ubuntu)
#   yum install bubblewrap (RHEL/Fedora)
#   pacman -S bubblewrap (Arch)
#
# Note: Ubuntu 24.04+ blocks unprivileged user namespaces by default
# via AppArmor. Workaround: set
#   kernel.apparmor_restrict_unprivileged_userns=0
# via sysctl or GRUB.
sandbox_mode = "none"

# Bubblewrap network access policy: "disabled" or "host".
#
# - "disabled" (default): pass --unshare-net to bubblewrap. The sandbox gets
#   a separate network namespace with no external network access.
#
# - "host": omit --unshare-net so the sandbox shares the host network namespace.
#   This allows outbound tools such as curl or ssh, subject to allowed_commands
#   and denied_commands. SSH keys, known_hosts, and SSH_AUTH_SOCK are still not
#   available unless separately exposed via filesystem/env configuration.
#
# This setting only affects sandbox_mode = "bwrap" or "bwrap-strict".
network_access = "disabled"

# ── Exa Web Search ────────────────────────────────────────────────
[exa]
api_key_env = "EXA_API_KEY"
max_results = 5
max_text_chars = 8000

# ── Runtime MCP Extensions ────────────────────────────────────────
# MCP servers are trusted extensions: their enabled tools have the same
# effective privileges as built-in tools. Version 1 supports Streamable HTTP
# only; stdio transport is deferred. Keep bearer tokens in the environment.
# include_tools = [] means all discovered tools. exclude_tools wins over it.
# tool_prefix, when set, is prepended to the remote tool names.
#
# [[mcp.servers]]
# name = "mail"
# enabled = true
# required = false
# tool_prefix = ""
# include_tools = ["mail_search", "mail_get"]
# exclude_tools = []
# connect_timeout_secs = 10
# call_timeout_secs = 60
#
# [mcp.servers.transport]
# type = "streamable_http"
# url = "http://127.0.0.1:8090/mcp"
# bearer_token_env = "MAILINDEX_API_TOKEN"
